# RateHawk (Worldota) API Credentials
# Ezeket a Supabase Dashboard-on kell beállítani: Settings → Edge Functions → Secrets

# RateHawk felhasználói azonosító
RATEHAWK_USER_ID=your_ratehawk_user_id_here

# RateHawk API kulcs
RATEHAWK_API_KEY=your_ratehawk_api_key_here

# ============================================
# FONTOS: Lokális fejlesztéshez
# ============================================
# Ha lokálisan teszteled az Edge Functions-t, másold ezt a fájlt .env.local néven:
# cp .env.example .env.local
# És töltsd ki a valós értékekkel.
#
# SOHA ne commitold a .env.local fájlt a git repóba!
